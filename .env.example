GEMINI_API_KEY=your_gemini_api_key_here
# ============================================================
# CNC Studio AI — Environment Configuration
# Copy to .env and fill in actual values
# ============================================================

# --- Environment Mode ---
# development | production
NODE_ENV=development

# --- AI Provider Credentials ---
# Google Gemini API key for Text-to-CAD parameter extraction
GEMINI_API_KEY=your_gemini_api_key_here
# Hugging Face token for Flux.1 Schnell latent diffusion model
HF_TOKEN=your_huggingface_token_here

# --- Backend Security & JWT ---
# Secret key for JWT token signing (min 32 chars, randomize in production)
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP Verification & Limits ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMTP Email Configuration ---
# IMPORTANT: For Gmail, generate an App Password at https://myaccount.google.com/apppasswords
# Do NOT use your regular Gmail password - it will fail with authentication errors.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=noreply@cncstudio.ai
SMTP_FROM_NAME=CNC Design Generator

# --- Database ---
# SQLite database connection URL
DATABASE_URL=sqlite:///./cad_studio.db


# --- AI Model Endpoint ---
# Override to point at a remote model inference server
MODEL_ENDPOINT=http://127.0.0.1:8000/api/v1/generation

# --- 2D Service Endpoints (New Architecture) ---
AI_SERVER_2D_URL=http://127.0.0.1:8001
EDIT_SERVER_URL=http://localhost:8002
NESTING_WORKER_URL=http://localhost:8003
INTERNAL_API_KEY=cad_studio_internal_secret_2026


# --- Storage Paths ---
# Local directories for generated CAD output and user uploads
STORAGE_OUTPUT_DIR=storage/outputs
STORAGE_UPLOAD_DIR=storage/uploads
STORAGE_TEMP_DIR=storage/temp
# Maximum upload file size in bytes (50MB default)
MAX_UPLOAD_SIZE_BYTES=52428800

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend Dev Server ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log output directory
LOG_DIR=logs
