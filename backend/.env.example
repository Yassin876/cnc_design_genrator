# ============================================================
# CNC Design Generator Backend — Environment Configuration
# Copy to backend/.env or root .env and fill in actual values
# ============================================================

# --- Application ---
NODE_ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./cad_studio.db

# --- Security & JWT ---
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- OTP Verification ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMTP Email Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD
SMTP_FROM_EMAIL=noreply@cncstudio.ai
SMTP_FROM_NAME=CNC Design Generator

# Model Endpiont 
MODEL_ENDPOINT=https://chargable-ashley-tychistic.ngrok-free.dev

# --- Server Binding ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
